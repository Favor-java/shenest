{
  "name": "shenest-server",
  "version": "1.0.0",
  "private": true,
  "description": "Convenience commands for the Java Spring Boot website and API",
  "scripts": {
    "dev": "sh ./mvnw spring-boot:run",
    "start": "sh ./mvnw spring-boot:run",
    "build": "sh ./mvnw package",
    "seed": "sh ./mvnw spring-boot:run -Dspring-boot.run.arguments=--shenest.seed=true"
  }
}
